{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codra",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "codra.esau.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codra-db",
      "database_id": "9dadb7d9-d0ca-4c80-a778-cb661d3398fd",
      "migrations_dir": "../../packages/db/migrations-d1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "3fadf3360ebf489a98852d295a13f5a5"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REVIEW_QUEUE",
        "queue": "codra-review-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "codra-review-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "retry_delay": 60,
        "max_retries": 3
      }
    ]
  },
  "workflows": [
    {
      "name": "codra-review-workflow",
      "binding": "REVIEW_WORKFLOW",
      "class_name": "ReviewWorkflow"
    }
  ],
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  },
  "assets": {
    "directory": "../../dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/login",
      "/dashboard*",
      "/jobs*",
      "/repos*",
      "/stats*",
      "/health*",
      "/api/*",
      "/auth/*",
      "/webhook*",
      "/settings*"
    ]
  },
  "secrets": {
    "required": [
      "APP_PRIVATE_KEY",
      "GITHUB_APP_ID",
      "GITHUB_APP_WEBHOOK_SECRET",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "LLM_CONFIG_ENCRYPTION_KEY"
    ]
  },
  "vars": {
    "APP_URL": "https://codra.esau.app",
    "AUTH_CALLBACK_URL": "https://codra.esau.app/auth/github/callback",
    "BOT_USERNAME": "codra-esau-org",
    "GITHUB_APP_SLUG": "codra-esau-org",
    "DASHBOARD_ALLOWED_USERS": "petergstfsn",
    "ENVIRONMENT": "production"
  }
}
